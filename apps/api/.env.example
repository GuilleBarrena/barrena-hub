PORT=3002

# Supabase → Connect → "Session pooler" (port 5432). Use it (or the direct
# connection) for this long-running server and for migrations; the "Transaction
# pooler" (port 6543) is meant for serverless.
#
# Plain variables (not sensitive)
DATABASE_HOST=aws-0-<region>.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres.<project-ref>

# Secret — store it as a secret in your hosting provider / CI.
DATABASE_PASSWORD=

# Optional. SSL is on by default. Paste Supabase's CA certificate (newlines as \n)
# to verify the server certificate; set DATABASE_SSL=false only for a local Postgres.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DATABASE_SSL=false
# DATABASE_LOGGING=true
